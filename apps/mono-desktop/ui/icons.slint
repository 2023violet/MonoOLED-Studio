// Deterministic line icons (V1 `studio_icons.py` style: 1.5px round strokes,
// theme-coloured, no font dependency). Paths are in a 24x24 viewbox.
import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.text-secondary;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    fill: transparent;
    commands: name == "folder" ? "M3 7 L3 19 L21 19 L21 9 L11 9 L9 6 L3 6 Z"
        : name == "undo" ? "M9 7 L4 12 L9 17 M4 12 L15 12 C18 12 20 14 20 17"
        : name == "redo" ? "M15 7 L20 12 L15 17 M20 12 L9 12 C6 12 4 14 4 17"
        : name == "settings" ? "M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 M12 2 L12 5 M12 19 L12 22 M2 12 L5 12 M19 12 L22 12 M5 5 L7 7 M17 17 L19 19 M5 19 L7 17 M17 7 L19 5"
        : name == "save" ? "M5 4 L16 4 L20 8 L20 20 L4 20 L4 4 Z M8 4 L8 9 L15 9 L15 4 M8 20 L8 14 L16 14 L16 20"
        : name == "pencil" ? "M4 20 L8 19 L19 8 L16 5 L5 16 Z M14 7 L17 10"
        : name == "eraser" ? "M8 20 L20 20 M5 15 L13 7 L19 13 L12 20 L8 20 Z M9 11 L15 17"
        : name == "line" ? "M5 19 L19 5"
        : name == "rect" ? "M5 6 L19 6 L19 18 L5 18 Z"
        : name == "fill" ? "M5 12 L12 5 L19 12 L12 19 Z M19 15 C19 17 21 19 21 19 C21 19 23 17 23 15"
        : name == "select" ? "M4 4 L8 4 M12 4 L16 4 M20 4 L20 8 M20 12 L20 16 M20 20 L16 20 M12 20 L8 20 M4 20 L4 16 M4 12 L4 8"
        : name == "move" ? "M12 3 L12 21 M3 12 L21 12 M12 3 L9 6 M12 3 L15 6 M12 21 L9 18 M12 21 L15 18 M3 12 L6 9 M3 12 L6 15 M21 12 L18 9 M21 12 L18 15"
        : name == "text" ? "M5 6 L19 6 M12 6 L12 19 M9 19 L15 19"
        : name == "flip-h" ? "M12 3 L12 21 M9 6 L4 12 L9 18 Z M15 6 L20 12 L15 18 Z"
        : name == "flip-v" ? "M3 12 L21 12 M6 9 L12 4 L18 9 Z M6 15 L12 20 L18 15 Z"
        : name == "rotate" ? "M20 12 A8 8 0 1 1 17 6 M17 2 L17 6 L21 6"
        : name == "invert" ? "M12 4 A8 8 0 1 0 12 20 Z M12 4 A8 8 0 1 1 12 20"
        : name == "clear" ? "M5 7 L19 7 M9 7 L9 4 L15 4 L15 7 M7 7 L8 20 L16 20 L17 7"
        : name == "zoom-in" ? "M10 4 A6 6 0 1 0 10 16 A6 6 0 1 0 10 4 M15 15 L20 20 M7 10 L13 10 M10 7 L10 13"
        : name == "zoom-out" ? "M10 4 A6 6 0 1 0 10 16 A6 6 0 1 0 10 4 M15 15 L20 20 M7 10 L13 10"
        : name == "export" ? "M12 4 L12 15 M7 9 L12 4 L17 9 M5 15 L5 20 L19 20 L19 15"
        : name == "import" ? "M12 15 L12 4 M7 10 L12 15 L17 10 M5 15 L5 20 L19 20 L19 15"
        : name == "agent" ? "M7 8 L17 8 L17 18 L7 18 Z M10 12 L10 13 M14 12 L14 13 M12 4 L12 8 M4 12 L7 12 M17 12 L20 12"
        : name == "chart" ? "M5 20 L5 12 M10 20 L10 6 M15 20 L15 10 M20 20 L20 4"
        : name == "plus" ? "M12 5 L12 19 M5 12 L19 12"
        : name == "close" ? "M6 6 L18 18 M18 6 L6 18"
        : "M12 12 L12 12";
}
