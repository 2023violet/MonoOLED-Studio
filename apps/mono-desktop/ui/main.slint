// MonoOLED Studio main window.
import { Theme, Metrics } from "theme.slint";
import { LineEdit, AboutSlint, Palette, ListView } from "std-widgets.slint";
import { Icon } from "icons.slint";
import { Shell, I18n, Button, ButtonRole, Segmented, StatusPill, PillTone, Caption, Scrim, Dialog, ListRow, Tooltip } from "widgets.slint";
import { PreferencesDialog, PrefsModel, PrefRow } from "preferences.slint";
import { DesignerView, DesignerModel, ScreenItem, ElementItem, AssetItem, FindingItem, OverlayBox, StateVar } from "designer.slint";
import { PixelView, PixelDialogs, PixelModel, OutputModel } from "pixel.slint";
import { FontLabView, FontModel, GlyphItem } from "fontlab.slint";
import { ReviewView, ReviewModel, ReviewElement } from "review.slint";
import { GalleryOverlay, GalleryModel, GalleryItem } from "gallery.slint";
import { AgentPanel, AgentModel } from "agent.slint";
import { NewProjectDialog, NewProjectModel } from "new_project.slint";
import { NoteDialog, NoteList, NoteModel, NoteItem } from "notes.slint";
// `notes.slint` is also imported by designer.slint; re-export the model so the
// generated Rust API is public.
export { NoteItem, NoteModel }
import { WelcomeView } from "welcome.slint";

export { Theme, Metrics, I18n, DesignerModel, ScreenItem, ElementItem, AssetItem, FindingItem, OverlayBox, StateVar, PillTone, PixelModel, OutputModel, FontModel, GlyphItem, PrefsModel, PrefRow, Shell, ReviewModel, ReviewElement, GalleryModel, GalleryItem, AgentModel, NewProjectModel }

export struct PickerItem { label: string, detail: string }
export struct BlockedItem { severity: string, code: string, message: string, frame: string, jumpable: bool }

export global AppModel {
    in property <string> project-name;
    in property <string> status-text;
    in property <string> agent-text;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // "Undo" plus what the next step really reverts, e.g. "Undo: move".
    in property <string> undo-text;
    in property <bool> dirty;
    in property <bool> has-project;
    in property <[string]> recent-projects;
    in property <bool> can-save;
    in property <bool> can-export;
    in property <bool> can-handoff;
    in property <bool> can-agent;
    in property <string> save-label;
    in property <string> health-text;
    in property <PillTone> health-tone: PillTone.neutral;
    in-out property <int> workspace: 0;
    // Busy state of a background job: the StatusBar shows `busy-text` and a
    // cancel control while it is set.
    in property <bool> busy;
    in property <string> busy-text;
    in property <string> repo-url;
    in property <string> docs-url;
    callback about-link(string /* url */);
    in-out property <bool> prompt-visible;
    in property <string> prompt-title;
    in property <string> prompt-label;
    in-out property <string> prompt-text;
    in-out property <bool> about-visible;
    in-out property <bool> preferences-visible;
    in-out property <bool> agent-panel-visible;
    // Set from CARGO_PKG_VERSION at startup; no literal default, so the About
    // dialog can never show a version the binary is not.
    in property <string> version;
    in-out property <bool> picker-visible;
    in property <string> picker-title;
    in property <[PickerItem]> picker-items;
    in-out property <string> picker-filter;
    in-out property <bool> blocked-visible;
    in property <[BlockedItem]> blocked-items;
    in property <string> blocked-report;
    in property <string> blocked-summary;
    callback picker-filter-changed(string);
    callback picker-chosen(int);
    callback recent-chosen(int);
    callback blocked-jump(int);
    callback blocked-copy();
    callback blocked-close();
    callback prompt-accepted(string);
    callback prompt-cancelled();
    callback action(string);
    // Key chord such as "Ctrl+S" → true when a configured shortcut consumed it.
    callback key-chord(string) -> bool;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();
    width: Metrics.control-height + 4px;
    height: Metrics.control-height + 4px;
    border-radius: Metrics.radius-control;
    background: touch.has-hover && enabled ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: tip;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        tint: root.enabled ? Theme.text-secondary : Theme.text-disabled;
    }
    tooltip-window := Tooltip {
        text: root.tip;
        anchor-x: root.absolute-position.x;
        anchor-y: root.absolute-position.y;
        anchor-w: root.width;
        anchor-h: root.height;
    }
    touch := TouchArea {
        enabled: root.enabled;
        changed has-hover => {
            if (touch.has-hover && root.tip != "" && root.enabled) {
                tooltip-window.show();
            } else {
                tooltip-window.close();
            }
        }
        clicked => { root.clicked(); }
    }
}

component CommandBar inherits Rectangle {
    height: 56px;
    background: Theme.surface-toolbar;
    border-width: 0px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        alignment: stretch;
        IconButton { icon: "folder"; tip: I18n.tr(I18n.lang, "action.open_project"); clicked => { AppModel.action("open-project"); } }
        IconButton { icon: "undo"; tip: AppModel.undo-text; enabled: AppModel.can-undo; clicked => { AppModel.action("undo"); } }
        IconButton { icon: "redo"; tip: I18n.tr(I18n.lang, "action.redo"); enabled: AppModel.can-redo; clicked => { AppModel.action("redo"); } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            min-width: 90px;
            horizontal-stretch: 1;
            Text { text: AppModel.project-name == "" ? I18n.tr(I18n.lang, "app.title") : AppModel.project-name + (AppModel.dirty ? " •" : ""); font-size: 15px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
            Caption { text: I18n.tr(I18n.lang, "app.subtitle"); wrap: no-wrap; overflow: elide; }
        }
        Rectangle { horizontal-stretch: 1; }
        Segmented {
            items: [I18n.tr(I18n.lang, "workspace.design"), I18n.tr(I18n.lang, "workspace.pixel"), I18n.tr(I18n.lang, "workspace.font"), I18n.tr(I18n.lang, "workspace.review")];
            current <=> AppModel.workspace;
            selected(i) => { AppModel.action("workspace:" + i); }
        }
        Rectangle { horizontal-stretch: 1; }
        StatusPill { text: AppModel.health-text; tone: AppModel.health-tone; }
        Button { text: I18n.tr(I18n.lang, "action.batch_validate"); tooltip: I18n.tr(I18n.lang, "tooltip.validate"); enabled: AppModel.can-export; clicked => { AppModel.action("batch-validate"); } }
        Button { text: I18n.tr(I18n.lang, "action.handoff"); tooltip: I18n.tr(I18n.lang, "tooltip.export"); enabled: AppModel.can-handoff; clicked => { AppModel.action("handoff"); } }
        Button { text: AppModel.save-label; enabled: AppModel.can-save; role: ButtonRole.primary; clicked => { AppModel.action("save"); } }
        IconButton { icon: "settings"; tip: I18n.tr(I18n.lang, "action.preferences"); clicked => { AppModel.action("preferences"); } }
    }
}

component StatusBar inherits Rectangle {
    height: 26px;
    background: Theme.surface-toolbar;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text { text: AppModel.busy ? AppModel.busy-text : AppModel.status-text; font-size: Metrics.font-small; color: Theme.text-muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        // A running job is only cancellable from here while the status bar is
        // 26px tall, so this is an inline control rather than a `Button`.
        if AppModel.busy: Rectangle {
            horizontal-stretch: 0;
            height: 20px;
            min-width: cancel-label.preferred-width + 16px;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-normal;
            background: cancel-touch.has-hover ? Theme.surface-hover : transparent;
            accessible-role: button;
            accessible-label: cancel-label.text;
            accessible-action-default => { AppModel.action("cancel-job"); }
            cancel-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { AppModel.action("cancel-job"); }
            }
            cancel-label := Text {
                text: I18n.tr(I18n.lang, "action.cancel_job");
                font-size: Metrics.font-small;
                color: Theme.text-primary;
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                vertical-alignment: center;
            }
        }
        Text { text: I18n.tr(I18n.lang, "footer.truth"); font-size: Metrics.font-small; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 0; }
        Text { text: AppModel.agent-text; font-size: Metrics.font-small; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 0; }
    }
}

component PromptDialog inherits Scrim {
    dismissed => { AppModel.prompt-visible = false; AppModel.prompt-cancelled(); }
    Dialog {
        height: 190px;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: AppModel.prompt-title; font-size: 16px; font-weight: 700; color: Theme.text-primary; }
            Text { text: AppModel.prompt-label; color: Theme.text-secondary; }
            input := LineEdit {
                text <=> AppModel.prompt-text;
                accepted(t) => { AppModel.prompt-accepted(t); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button { text: I18n.tr(I18n.lang, "dialog.cancel"); clicked => { AppModel.prompt-visible = false; AppModel.prompt-cancelled(); } }
                Button { text: I18n.tr(I18n.lang, "dialog.ok"); role: ButtonRole.primary; clicked => { AppModel.prompt-accepted(AppModel.prompt-text); } }
            }
        }
    }
    init => { input.focus(); }
}

// Searchable list (V1 CommandPalette / QInputDialog.getItem).
component PickerDialog inherits Scrim {
    dismissed => {
        AppModel.picker-visible = false;
        AppModel.picker-filter = "";
        AppModel.picker-filter-changed("");
    }
    Dialog {
        width: 520px;
        height: 430px;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: AppModel.picker-title; font-size: 16px; font-weight: 700; color: Theme.text-primary; }
            filter := LineEdit {
                text <=> AppModel.picker-filter;
                placeholder-text: I18n.tr(I18n.lang, "command.search");
                edited(t) => { AppModel.picker-filter-changed(t); }
                accepted => { if (AppModel.picker-items.length > 0) { AppModel.picker-chosen(0); } }
            }
            ListView {
                vertical-stretch: 1;
                for item[index] in AppModel.picker-items: ListRow {
                    text: item.label;
                    detail: item.detail;
                    selected: index == 0 && AppModel.picker-filter != "";
                    clicked => { AppModel.picker-chosen(index); }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button { text: I18n.tr(I18n.lang, "dialog.cancel"); clicked => { AppModel.picker-visible = false; } }
            }
        }
    }
    init => { filter.focus(); }
}

component AboutDialog inherits Scrim {
    dismissed => { AppModel.about-visible = false; }
    Dialog {
        height: 360px;
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            Text { text: "MonoOLED Studio " + AppModel.version; font-size: 18px; font-weight: 700; color: Theme.text-primary; }
            Text { text: I18n.tr(I18n.lang, "app.subtitle"); color: Theme.text-secondary; wrap: word-wrap; }
            Text { text: "MIT License · Rust · Slint"; color: Theme.text-muted; font-size: Metrics.font-small; }
            AboutSlint { height: 140px; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "GitHub"; role: ButtonRole.ghost; clicked => { AppModel.about-link(AppModel.repo-url); } }
                Button { text: I18n.tr(I18n.lang, "about.docs"); role: ButtonRole.ghost; clicked => { AppModel.about-link(AppModel.docs-url); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: I18n.tr(I18n.lang, "dialog.close"); role: ButtonRole.primary; clicked => { AppModel.about-visible = false; } }
            }
        }
    }
    init => { root.take-focus(); }
}

// Release gate refused the export: blocking findings, with a jump back to the
// offending element and the path of the written report.
component BlockedDialog inherits Scrim {
    dismissed => { AppModel.blocked-close(); }
    Dialog {
        width: 640px;
        height: 540px;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            Text { text: I18n.tr(I18n.lang, "dialog.blocked_title"); font-size: 16px; font-weight: 700; color: Theme.text-primary; }
            Text { text: AppModel.blocked-summary; color: Theme.text-secondary; wrap: word-wrap; }
            Caption { text: AppModel.blocked-report; wrap: no-wrap; overflow: elide; }
            ListView {
                vertical-stretch: 1;
                for item[index] in AppModel.blocked-items: Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 8px;
                        StatusPill {
                            horizontal-stretch: 0;
                            width: self.min-width;
                            text: item.severity;
                            tone: item.severity == "BLOCKER" || item.severity == "ERROR" ? PillTone.error : PillTone.warning;
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: item.code + " · " + item.message; font-size: Metrics.font-body; color: Theme.text-primary; overflow: elide; vertical-alignment: center; }
                            Text { text: item.frame; font-size: Metrics.font-small; color: Theme.text-muted; overflow: elide; }
                        }
                        Button { visible: item.jumpable; text: I18n.tr(I18n.lang, "dialog.blocked_jump"); clicked => { AppModel.blocked-jump(index); } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: I18n.tr(I18n.lang, "dialog.blocked_copy"); clicked => { AppModel.blocked-copy(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: I18n.tr(I18n.lang, "dialog.close"); role: ButtonRole.primary; clicked => { AppModel.blocked-close(); } }
            }
        }
    }
    init => { root.take-focus(); }
}

export component MainWindow inherits Window {
    title: (AppModel.project-name == "" ? "" : AppModel.project-name + (AppModel.dirty ? " • " : " — ")) + "MonoOLED Studio";
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 1100px;
    min-height: 700px;
    background: Theme.app-background;
    default-font-size: Metrics.font-body;
    default-font-family: "Microsoft YaHei UI";
    icon: @image-url("../assets/monooled.png");
    public function focus-shortcuts() { shortcuts.focus(); }
    // std-widgets follow the app theme, not the OS colour scheme.
    property <bool> dark-theme: Theme.dark;
    // Any modal owns keyboard focus; when the last one closes, the shortcuts
    // scope takes it back instead of leaving the window without a focus owner.
    property <bool> overlay-open:
        AppModel.preferences-visible || AppModel.picker-visible
        || AppModel.prompt-visible || AppModel.about-visible || AppModel.blocked-visible
        || NewProjectModel.visible || NoteModel.visible || GalleryModel.visible
        || (AppModel.workspace == 1 && PixelModel.dialog != 0);
    changed overlay-open => { if (!self.overlay-open) { shortcuts.focus(); } }
    changed dark-theme => { Palette.color-scheme = self.dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed width => { Shell.window-width = self.width; }
    init => {
        Shell.window-width = self.width;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
        shortcuts.focus();
    }

    MenuBar {
        Menu {
            title: I18n.tr(I18n.lang, "menu.file");
            MenuItem { title: I18n.tr(I18n.lang, "action.new_project"); activated => { AppModel.action("new-project"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.open_project"); activated => { AppModel.action("open-project"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.open_scene"); activated => { AppModel.action("open-scene"); } }
            MenuSeparator { }
            MenuItem { title: AppModel.save-label; enabled: AppModel.can-save; activated => { AppModel.action("save"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.export_current"); enabled: AppModel.can-export; activated => { AppModel.action("export-current"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.export_all"); enabled: AppModel.can-export; activated => { AppModel.action("export-all"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.handoff"); enabled: AppModel.can-handoff; activated => { AppModel.action("handoff"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.export_c_header"); enabled: AppModel.can-export; activated => { AppModel.action("export-c-header"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.thumbnail_wall"); enabled: AppModel.can-export; activated => { AppModel.action("thumbnail-wall"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.review_pack"); enabled: AppModel.has-project; activated => { AppModel.action("review-pack"); } }
            MenuSeparator { }
            MenuItem { title: I18n.tr(I18n.lang, "action.exit"); activated => { AppModel.action("exit"); } }
        }
        Menu {
            title: I18n.tr(I18n.lang, "menu.edit");
            MenuItem { title: AppModel.undo-text; enabled: AppModel.can-undo; activated => { AppModel.action("undo"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.redo"); enabled: AppModel.can-redo; activated => { AppModel.action("redo"); } }
            MenuSeparator { }
            MenuItem { title: I18n.tr(I18n.lang, "action.add_placeholder"); enabled: AppModel.has-project; activated => { AppModel.action("add-placeholder"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.assign_bitmap"); enabled: AppModel.has-project && DesignerModel.has-selection; activated => { AppModel.action("assign-bitmap"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.duplicate"); enabled: DesignerModel.has-selection; activated => { AppModel.action("duplicate"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.delete"); enabled: DesignerModel.has-selection; activated => { AppModel.action("delete"); } }
        }
        Menu {
            title: I18n.tr(I18n.lang, "menu.arrange");
            MenuItem { title: I18n.tr(I18n.lang, "action.front"); activated => { AppModel.action("front"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.back"); activated => { AppModel.action("back"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.group"); activated => { AppModel.action("group"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.ungroup"); activated => { AppModel.action("ungroup"); } }
            MenuSeparator { }
            MenuItem { title: I18n.tr(I18n.lang, "align.left"); activated => { AppModel.action("align:left"); } }
            MenuItem { title: I18n.tr(I18n.lang, "align.right"); activated => { AppModel.action("align:right"); } }
            MenuItem { title: I18n.tr(I18n.lang, "align.top"); activated => { AppModel.action("align:top"); } }
            MenuItem { title: I18n.tr(I18n.lang, "align.bottom"); activated => { AppModel.action("align:bottom"); } }
        }
        Menu {
            title: I18n.tr(I18n.lang, "menu.view");
            MenuItem { title: I18n.tr(I18n.lang, "workspace.design"); activated => { AppModel.action("workspace:0"); } }
            MenuItem { title: I18n.tr(I18n.lang, "workspace.pixel"); activated => { AppModel.action("workspace:1"); } }
            MenuItem { title: I18n.tr(I18n.lang, "workspace.font"); activated => { AppModel.action("workspace:2"); } }
            MenuItem { title: I18n.tr(I18n.lang, "workspace.review"); activated => { AppModel.action("workspace:3"); } }
            MenuSeparator { }
            // Slint 1.18 cannot two-way-bind MenuItem.checked (the framework
            // flips it and MenuBar internals are not reachable), so the
            // checkmark is rendered from the shell state: always truthful.
            MenuItem { title: (Shell.hide-drawer ? "     " : "✓  ") + I18n.tr(I18n.lang, "action.diagnostics"); activated => { AppModel.action("diagnostics"); } }
            MenuItem { title: (Shell.hide-navigator ? "     " : "✓  ") + I18n.tr(I18n.lang, "view.navigator"); activated => { AppModel.action("toggle-navigator"); } }
            MenuItem { title: (Shell.hide-inspector ? "     " : "✓  ") + I18n.tr(I18n.lang, "view.inspector"); activated => { AppModel.action("toggle-inspector"); } }
            MenuItem { title: (Shell.canvas-only ? "✓  " : "     ") + I18n.tr(I18n.lang, "view.canvas_only"); activated => { AppModel.action("canvas-only"); } }
            MenuItem { title: I18n.tr(I18n.lang, "view.reset_workspace"); activated => { AppModel.action("reset-workspace"); } }
            MenuSeparator { }
            MenuItem { title: I18n.tr(I18n.lang, "view.gallery"); enabled: AppModel.has-project; activated => { AppModel.action("gallery"); } }
        }
        Menu {
            title: I18n.tr(I18n.lang, "menu.tools");
            MenuItem { title: I18n.tr(I18n.lang, "action.preferences"); activated => { AppModel.action("preferences"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.asset_health"); enabled: AppModel.has-project; activated => { AppModel.action("asset-health"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.save_template"); enabled: AppModel.has-project; activated => { AppModel.action("save-template"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.insert_template"); enabled: AppModel.has-project; activated => { AppModel.action("insert-template"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.convert_asset"); enabled: AppModel.has-project; activated => { AppModel.action("convert-asset"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.agent_bridge"); enabled: AppModel.can-agent; activated => { AppModel.action("agent-bridge"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.bitmap_text"); activated => { AppModel.action("bitmap-text"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.autosave"); activated => { AppModel.action("autosave"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.restore_autosave"); activated => { AppModel.action("restore-autosave"); } }
            MenuSeparator { }
            MenuItem { title: I18n.tr(I18n.lang, "command.title"); activated => { AppModel.action("command-palette"); } }
        }
        Menu {
            title: I18n.tr(I18n.lang, "menu.help");
            MenuItem { title: I18n.tr(I18n.lang, "action.shortcuts"); activated => { AppModel.action("shortcuts"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.docs"); activated => { AppModel.action("open-docs"); } }
            MenuItem { title: I18n.tr(I18n.lang, "action.report_issue"); activated => { AppModel.action("report-issue"); } }
            MenuSeparator { }
            MenuItem { title: I18n.tr(I18n.lang, "action.about"); activated => { AppModel.action("about"); } }
        }
    }

    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == "" || event.text == Key.Shift || event.text == Key.Control || event.text == Key.Alt || event.text == Key.Meta) { return reject; }
            if (AppModel.key-chord((event.modifiers.control ? "Ctrl+" : "") + (event.modifiers.alt ? "Alt+" : "") + (event.modifiers.shift ? "Shift+" : "") + (event.text == " " ? "Space" : event.text))) {
                return accept;
            }
            return reject;
        }
    VerticalLayout {
        CommandBar { }
        Rectangle { height: 1px; background: Theme.border-subtle; }
        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                if AppModel.workspace == 0 && !AppModel.has-project: WelcomeView {
                    vertical-stretch: 1;
                    recent-projects: AppModel.recent-projects;
                    open-project => { AppModel.action("open-project"); }
                    new-project => { AppModel.action("new-project"); }
                    recent-chosen(index) => { AppModel.recent-chosen(index); }
                }
                if AppModel.workspace == 0 && AppModel.has-project: DesignerView { vertical-stretch: 1; }
                if AppModel.workspace == 1: PixelView { vertical-stretch: 1; }
                if AppModel.workspace == 2: FontLabView { vertical-stretch: 1; }
                if AppModel.workspace == 3: ReviewView { vertical-stretch: 1; }
            }
        }
        StatusBar { }
    }
    // Overlays live inside the shortcuts scope: their dialogs sit in its focus
    // chain, so a chord that arrives while a modal owns focus still dispatches
    // and closing a modal never strands the window without a focus owner.
    if AppModel.agent-panel-visible: AgentPanel {
        x: root.width - self.width - 16px;
        y: 72px;
    }
    if AppModel.workspace == 1 && PixelModel.dialog != 0: PixelDialogs { width: root.width; height: root.height; }
    if AppModel.blocked-visible: BlockedDialog { width: root.width; height: root.height; }
    if AppModel.preferences-visible: PreferencesDialog { width: root.width; height: root.height; }
    if AppModel.picker-visible: PickerDialog { width: root.width; height: root.height; }
    if AppModel.prompt-visible: PromptDialog { width: root.width; height: root.height; }
    if NewProjectModel.visible: NewProjectDialog { width: root.width; height: root.height; refocus => { root.focus-shortcuts(); } }
    if NoteModel.visible: NoteDialog { width: root.width; height: root.height; refocus => { root.focus-shortcuts(); } }
    if GalleryModel.visible: GalleryOverlay { width: root.width; height: root.height; refocus => { root.focus-shortcuts(); } }
    if AppModel.about-visible: AboutDialog { width: root.width; height: root.height; }
    }
}
