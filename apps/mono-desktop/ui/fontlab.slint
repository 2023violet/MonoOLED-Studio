// Font Lab workspace: glyph list | glyph canvas (shared PixelCanvas) | generator form
// (V1 `font_lab_qt.FontLabEditor`).
import { ScrollView, LineEdit, SpinBox, ComboBox, CheckBox, ListView } from "std-widgets.slint";
import { Theme, Metrics } from "theme.slint";
import { I18n, Button, ButtonRole, Panel, SectionTitle, Caption, Label, StatusPill, PillTone, ListRow, Scroll } from "widgets.slint";
import { PixelModel, PixelCanvas, ToolRail } from "pixel.slint";

export struct GlyphItem { text: string, code: string }

export global FontModel {
    in property <bool> has-pack;
    in property <string> pack-title;
    in property <string> pack-state;
    in property <PillTone> pack-tone: PillTone.neutral;
    in property <string> pack-path;
    in property <[GlyphItem]> glyphs;
    in property <int> current: -1;
    in property <string> characters;
    in property <string> font-path;
    in property <int> font-size: 7;
    in property <int> cell-w: 5;
    in property <int> cell-h: 8;
    in property <int> baseline: 6;
    in property <int> advance: 6;
    in property <int> threshold: 128;
    in property <int> offset-x: 0;
    in property <int> offset-y: 0;
    in property <int> alignment: 1;
    in property <int> antialias: 0;
    in property <bool> busy;
    in property <string> status;
    in property <string> error;
    in property <[string]> packs;
    in property <image> preview;
    in-out property <bool> real-preview: true;
    callback glyph-chosen(int);
    callback edit(string /* field */, string /* value */);
    callback font-action(string);
}

component FormRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 6px;
    Label { text: root.label; width: 96px; }
    @children
}

export component FontLabView inherits HorizontalLayout {
    // Kept from the original fix; the `visible` read below is a harmless
    // leftover, not what makes the `changed` handler run (1.18 fires it anyway).
    private property <int> glyph-current: FontModel.current;
    changed glyph-current => {
        glyphs.content-y = Scroll.into-view(glyph-current, Metrics.control-height + 4px,
            glyphs.content-y, glyphs.visible-height, glyphs.content-height);
    }
    spacing: 8px;
    property <int> preview-scale: 8;
    Panel {
        min-width: 200px;
        preferred-width: 200px;
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            SectionTitle { text: I18n.tr(I18n.lang, "font.characters"); }
            if FontModel.glyphs.length == 0: Caption { text: FontModel.has-pack ? I18n.tr(I18n.lang, "font.selection.none") : I18n.tr(I18n.lang, "font.empty"); }
            glyphs := ListView {
                vertical-stretch: 1;
                visible: glyph-current >= -1;
                for glyph[index] in FontModel.glyphs: ListRow {
                    text: glyph.text;
                    detail: glyph.code;
                    selected: index == FontModel.current;
                    clicked => { FontModel.glyph-chosen(index); }
                }
            }
            if FontModel.packs.length > 0: SectionTitle { text: I18n.tr(I18n.lang, "font.select_title"); }
            for pack in FontModel.packs: ListRow {
                text: pack;
                clicked => { FontModel.font-action("open:" + pack); }
            }
            HorizontalLayout {
                spacing: 6px;
                Button { text: I18n.tr(I18n.lang, "font.new_title"); horizontal-stretch: 1; enabled: !FontModel.busy; clicked => { FontModel.font-action("new"); } }
                Button { text: I18n.tr(I18n.lang, "font.open_title"); horizontal-stretch: 1; enabled: !FontModel.busy; clicked => { FontModel.font-action("open"); } }
            }
        }
    }
    if FontModel.has-pack: ToolRail { }
    Panel {
        horizontal-stretch: 1;
        min-width: 240px;
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                SectionTitle { text: FontModel.has-pack ? FontModel.pack-title : I18n.tr(I18n.lang, "font.title"); vertical-alignment: center; horizontal-stretch: 1; min-width: 0; overflow: elide; }
                if FontModel.has-pack: StatusPill { text: FontModel.cell-w + " × " + FontModel.cell-h; }
                if FontModel.has-pack: StatusPill { text: FontModel.pack-state; tone: FontModel.pack-tone; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: I18n.tr(I18n.lang, "font.save_glyph"); role: ButtonRole.primary; enabled: FontModel.has-pack && !FontModel.busy; clicked => { FontModel.font-action("save"); } }
            }
            // The pack path can be long: elide it instead of eating the columns.
            if FontModel.has-pack: Caption { text: FontModel.pack-path; wrap: no-wrap; overflow: elide; }
            if FontModel.has-pack: Caption { text: I18n.tr(I18n.lang, "font.save_scope_hint"); }
            if FontModel.has-pack: HorizontalLayout {
                spacing: 8px;
                Caption { text: I18n.tr(I18n.lang, "font.preview.label"); vertical-alignment: center; }
                Rectangle {
                    width: (FontModel.cell-w * root.preview-scale) * 1px;
                    height: (FontModel.cell-h * root.preview-scale) * 1px;
                    background: #000000;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    Image {
                        source: FontModel.preview;
                        width: parent.width;
                        height: parent.height;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }
                }
                preview-combo := ComboBox {
                    model: ["4×", "8×", "12×"];
                    current-index: 1;
                    width: 74px;
                    selected(_value) => { root.preview-scale = preview-combo.current-index == 0 ? 4 : preview-combo.current-index == 1 ? 8 : 12; }
                }
                CheckBox {
                    text: I18n.tr(I18n.lang, "font.preview.real");
                    checked: FontModel.real-preview;
                    toggled => { FontModel.real-preview = self.checked; }
                }
                Caption { text: I18n.tr(I18n.lang, "font.preview.hint"); }
            }
            if FontModel.has-pack: PixelCanvas { vertical-stretch: 1; }
            if !FontModel.has-pack: Rectangle {
                vertical-stretch: 1;
                Caption { text: I18n.tr(I18n.lang, "font.empty"); horizontal-alignment: center; }
            }
            Caption { text: PixelModel.cursor-text; wrap: no-wrap; }
        }
    }
    Panel {
        min-width: 340px;
        preferred-width: 340px;
        ScrollView {
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                alignment: start;
                SectionTitle { text: I18n.tr(I18n.lang, "font.generate"); }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.characters");
                    LineEdit { text: FontModel.characters; enabled: !FontModel.busy; edited(t) => { FontModel.edit("characters", t); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.source");
                    LineEdit { text: FontModel.font-path; placeholder-text: I18n.tr(I18n.lang, "font.source_builtin"); enabled: !FontModel.busy; accepted(t) => { FontModel.edit("font_path", t); } }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    if FontModel.font-path != "": Button { text: I18n.tr(I18n.lang, "dialog.cancel"); role: ButtonRole.ghost; enabled: !FontModel.busy; clicked => { FontModel.edit("font_path", ""); } }
                    Button { text: I18n.tr(I18n.lang, "font.browse"); enabled: !FontModel.busy; clicked => { FontModel.font-action("browse"); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.size");
                    SpinBox { value: FontModel.font-size; minimum: 4; maximum: 96; enabled: FontModel.font-path != "" && !FontModel.busy; edited(v) => { FontModel.edit("font_size", v); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.cell_width");
                    SpinBox { value: FontModel.cell-w; minimum: 1; maximum: 128; enabled: !FontModel.busy; edited(v) => { FontModel.edit("cell_w", v); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.cell_height");
                    SpinBox { value: FontModel.cell-h; minimum: 1; maximum: 128; enabled: !FontModel.busy; edited(v) => { FontModel.edit("cell_h", v); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.baseline");
                    SpinBox { value: FontModel.baseline; minimum: 0; maximum: max(0, FontModel.cell-h - 1); enabled: !FontModel.busy; edited(v) => { FontModel.edit("baseline", v); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.advance");
                    SpinBox { value: FontModel.advance; minimum: 1; maximum: 128; enabled: !FontModel.busy; edited(v) => { FontModel.edit("advance", v); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.threshold");
                    SpinBox { value: FontModel.threshold; minimum: 0; maximum: 255; enabled: FontModel.font-path != "" && !FontModel.busy; edited(v) => { FontModel.edit("threshold", v); } }
                }
                // Offsets leave the exact built-in 5x7 path, so they need a TrueType
                // source. They stay editable with no path set: a leftover offset is
                // what makes a font file required, so disabling these rows with the
                // path cleared would trap the form in a state that cannot generate.
                FormRow {
                    label: I18n.tr(I18n.lang, "font.offset_x");
                    SpinBox { value: FontModel.offset-x; minimum: -64; maximum: 64; enabled: !FontModel.busy; edited(v) => { FontModel.edit("offset_x", v); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.offset_y");
                    SpinBox { value: FontModel.offset-y; minimum: -64; maximum: 64; enabled: !FontModel.busy; edited(v) => { FontModel.edit("offset_y", v); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.alignment");
                    ComboBox { model: [I18n.tr(I18n.lang, "font.alignment.font_set"), I18n.tr(I18n.lang, "font.alignment.glyph_width")]; current-index: FontModel.alignment; enabled: !FontModel.busy; selected => { FontModel.edit("alignment", self.current-index); } }
                }
                FormRow {
                    label: I18n.tr(I18n.lang, "font.antialias");
                    ComboBox { model: ["1×", "2×"]; current-index: FontModel.antialias; enabled: !FontModel.busy; selected => { FontModel.edit("antialias", self.current-index + 1); } }
                }
                Button { text: I18n.tr(I18n.lang, "font.generate"); role: ButtonRole.primary; enabled: FontModel.has-pack && !FontModel.busy; clicked => { FontModel.font-action("generate"); } }
                Caption { text: FontModel.status; }
                if FontModel.error != "": Text { text: FontModel.error; color: Theme.status-error; font-size: Metrics.font-small; wrap: word-wrap; }
            }
        }
    }
}
