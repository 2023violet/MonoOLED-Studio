// Preferences (V1 `preferences_qt.PreferencesView`): section navigation, search,
// and a flat list of rows the controller builds from the preference schema.
import { ScrollView, LineEdit, SpinBox, ComboBox, CheckBox, ListView } from "std-widgets.slint";
import { Theme, Metrics } from "theme.slint";
import { I18n, Button, ButtonRole, Panel, SectionTitle, Caption, Label, Divider, ListRow, Scrim } from "widgets.slint";

// kind: "group" | "check" | "combo" | "spin" | "text" | "button" | "value" | "danger"
export struct PrefRow {
    kind: string,
    key: string,
    label: string,
    help: string,
    options: [string],
    index: int,
    value: int,
    minimum: int,
    maximum: int,
    text: string,
    checked: bool,
}

export global PrefsModel {
    in property <[string]> sections;
    in-out property <int> section: 0;
    in property <string> page-title;
    in property <string> page-desc;
    in property <[PrefRow]> rows;
    in-out property <string> search;
    in property <string> save-state;
    in property <string> error;
    in property <string> version;
    callback section-chosen(int);
    callback search-changed(string);
    callback changed(string /* key */, string /* value */);
    callback button(string /* key */);
    callback close();
}

component RowLabel inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    spacing: 2px;
    horizontal-stretch: 1;
    Text { text: root.label; color: Theme.text-primary; font-size: Metrics.font-body; wrap: word-wrap; }
    if root.help != "": Caption { text: root.help; }
}

component PrefRowView inherits HorizontalLayout {
    in property <PrefRow> item;
    spacing: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    if item.kind != "check": RowLabel { label: item.label; help: item.help; }
    if item.kind == "check": VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        CheckBox { text: item.label; checked: item.checked; toggled => { PrefsModel.changed(item.key, self.checked ? "true" : "false"); } }
        if item.help != "": Caption { text: item.help; }
    }
    if item.kind == "combo": ComboBox {
        width: 220px;
        model: item.options;
        current-index: item.index;
        selected => { PrefsModel.changed(item.key, self.current-index); }
    }
    if item.kind == "spin": SpinBox {
        width: 220px;
        value: item.value;
        minimum: item.minimum;
        maximum: item.maximum;
        edited(v) => { PrefsModel.changed(item.key, v); }
    }
    if item.kind == "text": LineEdit {
        width: 220px;
        text: item.text;
        accepted(t) => { PrefsModel.changed(item.key, t); }
    }
    if item.kind == "value": Text { width: 220px; text: item.text; color: Theme.text-secondary; vertical-alignment: center; }
    if item.kind == "button": Button { width: 220px; text: item.text; clicked => { PrefsModel.button(item.key); } }
    if item.kind == "danger": Button { width: 220px; text: item.text; role: ButtonRole.danger; clicked => { PrefsModel.button(item.key); } }
}

export component PreferencesDialog inherits Scrim {
    Rectangle {
        width: min(root.width - 80px, 980px);
        height: min(root.height - 80px, 720px);
        background: Theme.surface-panel;
        border-radius: Metrics.radius-panel;
        border-width: 1px;
        border-color: Theme.border-normal;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.popover-shadow;
        VerticalLayout {
            padding: 22px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 12px;
                Text { text: I18n.tr(I18n.lang, "pref.title"); font-size: 20px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if PrefsModel.save-state != "": Caption { text: PrefsModel.save-state; vertical-alignment: center; wrap: no-wrap; }
                LineEdit {
                    width: 280px;
                    text <=> PrefsModel.search;
                    placeholder-text: I18n.tr(I18n.lang, "pref.search");
                    edited(t) => { PrefsModel.search-changed(t); }
                }
                Button { text: I18n.tr(I18n.lang, "dialog.close"); role: ButtonRole.primary; clicked => { PrefsModel.close(); } }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 28px;
                VerticalLayout {
                    width: 172px;
                    spacing: 4px;
                    for name[index] in PrefsModel.sections: ListRow {
                        text: name;
                        selected: index == PrefsModel.section && PrefsModel.search == "";
                        clicked => { PrefsModel.section = index; PrefsModel.search = ""; PrefsModel.section-chosen(index); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Caption { text: "MonoOLED Studio"; }
                    Caption { text: "v" + PrefsModel.version; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    Text { text: PrefsModel.page-title; font-size: 17px; font-weight: 700; color: Theme.text-primary; }
                    Caption { text: PrefsModel.page-desc; }
                    if PrefsModel.error != "": Text { text: PrefsModel.error; color: Theme.status-error; font-size: Metrics.font-small; wrap: word-wrap; }
                    if PrefsModel.rows.length == 0: Caption { text: I18n.tr(I18n.lang, "pref.search.no_results"); }
                    ListView {
                        vertical-stretch: 1;
                        for row in PrefsModel.rows: VerticalLayout {
                            if row.kind == "group": VerticalLayout {
                                padding-top: 14px;
                                spacing: 4px;
                                SectionTitle { text: row.label; }
                                if row.help != "": Caption { text: row.help; }
                                Divider { }
                            }
                            if row.kind != "group": PrefRowView { item: row; }
                        }
                    }
                }
            }
        }
    }
}
