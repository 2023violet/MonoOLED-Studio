// Screen gallery: one card per screen (init frame, validation badge, notes),
// grouped by category and searchable. A full-window overlay, not a workspace.
import { LineEdit, ListView } from "std-widgets.slint";
import { Theme, Metrics } from "theme.slint";
import { I18n, Button, ButtonRole, Caption, Segmented, StatusPill, PillTone, Scrim } from "widgets.slint";

export struct GalleryItem {
    header: bool,
    title: string,
    detail: string,
    badge: string,
    bad: bool,
    screen: string,
    image: image,
}

export global GalleryModel {
    in-out property <bool> visible;
    in property <[GalleryItem]> items;
    in-out property <string> query;
    in-out property <int> filter;
    in property <string> summary;
    in property <bool> truncated;
    callback search(string);
    callback filter-changed(int);
    callback open-screen(string, bool);
    callback close();
}

component GalleryCard inherits Rectangle {
    in property <GalleryItem> item;
    height: 96px;
    border-radius: Metrics.radius-control;
    background: Theme.surface-toolbar;
    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Rectangle {
            width: 260px;
            height: 76px;
            background: Theme.canvas-off;
            border-radius: 4px;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.item.image;
                image-fit: contain;
                image-rendering: pixelated;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.item.title;
                font-size: Metrics.font-title;
                font-weight: 600;
                color: Theme.text-primary;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: root.item.detail;
                font-size: Metrics.font-small;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
        StatusPill {
            text: root.item.badge;
            tone: root.item.bad ? PillTone.error : PillTone.success;
        }
        Button {
            text: I18n.tr(I18n.lang, "gallery.open");
            clicked => { GalleryModel.open-screen(root.item.screen, false); }
        }
        Button {
            text: I18n.tr(I18n.lang, "gallery.review");
            role: ButtonRole.secondary;
            clicked => { GalleryModel.open-screen(root.item.screen, true); }
        }
    }
}

export component GalleryOverlay inherits Scrim {
    callback refocus();
    scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                GalleryModel.close();
                return accept;
            }
            return reject;
        }
        panel := Rectangle {
            width: parent.width - 120px;
            height: parent.height - 100px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-panel;
            border-radius: Metrics.radius-panel;
            border-width: 1px;
            border-color: Theme.border-normal;
            drop-shadow-blur: 24px;
            drop-shadow-color: Theme.popover-shadow;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: I18n.tr(I18n.lang, "gallery.title");
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    search-field := LineEdit {
                        width: 260px;
                        text <=> GalleryModel.query;
                        placeholder-text: I18n.tr(I18n.lang, "gallery.search");
                        edited(text) => { GalleryModel.search(text); }
                    }
                    Segmented {
                        items: [
                            I18n.tr(I18n.lang, "gallery.filter.all"),
                            I18n.tr(I18n.lang, "gallery.filter.blocking"),
                            I18n.tr(I18n.lang, "gallery.filter.annotated"),
                        ];
                        current: GalleryModel.filter;
                        selected(index) => { GalleryModel.filter-changed(index); }
                    }
                    Button {
                        text: I18n.tr(I18n.lang, "gallery.close");
                        clicked => { GalleryModel.close(); }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Caption { text: GalleryModel.summary; }
                    Rectangle { horizontal-stretch: 1; }
                    if GalleryModel.truncated: Caption {
                        text: I18n.tr(I18n.lang, "gallery.truncated");
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for item in GalleryModel.items: Rectangle {
                        height: item.header ? 30px : 104px;
                        if item.header: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: item.title;
                                font-size: Metrics.font-body;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: item.detail;
                                font-size: Metrics.font-small;
                                color: Theme.text-muted;
                            }
                        }
                        if !item.header: GalleryCard {
                            item: item;
                        }
                    }
                }
            }
        }
    }
    init => { search-field.focus(); }
}
