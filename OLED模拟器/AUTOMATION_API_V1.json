    "state.validate_schema": {
      "permission": "observe",
      "summary": "Validate a proposed root-level state schema without mutating the project.",
      "params": {
        "schema": {
          "type": "object",
          "required": true,
          "properties": {
            "variables": {
              "type": "object<string,state-variable>",
              "required": true,
              "variants": [
                {
                  "type": "int",
                  "fields": {
